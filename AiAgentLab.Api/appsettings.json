{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*",
  "App": {
    "Name": "AiAgentLab.Api",
    "Version": "0.1.0"
  },
  "Llm": {
    "Provider": "Gemini"
  },
  "Ollama": {
    "BaseUrl": "http://localhost:11434",
    "Model": "llama3.2",
    "TimeoutSeconds": 120
  },
  "Gemini": {
    "BaseUrl": "https://generativelanguage.googleapis.com",
    "ApiKey": "",
    "Model": "gemini-2.5-flash",
    "TimeoutSeconds": 120,
    "EmbeddingModel": "models/gemini-embedding-001",
    "EmbeddingDimensions": 768,
    "Temperature": 0.2
  },
  "Finnhub": {
    "BaseUrl": "https://finnhub.io/api/v1",
    "ApiKey": "",
    "TimeoutSeconds": 30
  },
  "VectorStore": {
    "Provider": "Sql",
    "TopK": 4,
    "MinScore": 0.6
  },
  "Qdrant": {
    "BaseUrl": "http://localhost:6333",
    "CollectionName": "document_chunks",
    "TimeoutSeconds": 30
  },
  "DocumentIngestion": {
    "FolderPath": "Documents",
    "ChunkSizeTokens": 500,
    "ChunkOverlapTokens": 50
  },
   "ConnectionStrings": {
    "AiAgentLab": "Server=(localdb)\\mssqllocaldb;Database=AiAgentLabDb;Integrated Security=true;"
  }
}
